{
  "name": "swolley/laraplate-sao",
  "vendor": "swolley",
  "description": "SAO module for Laraplate: Simply Another Orchestrator — correlation engine between code, errors and work.",
  "version": "v1.2.0",
  "keywords": [
    "laravel",
    "laraplate",
    "sao",
    "orchestrator",
    "issue-tracking"
  ],
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "type": "laravel-module",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/swolley/license-compliance-checker.git",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.5",
    "laravel/framework": "^12.0"
  },
  "scripts": {
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [],
      "aliases": {}
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\SAO\\": "app/",
      "Modules\\SAO\\Database\\Factories\\": "database/factories/",
      "Modules\\SAO\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\SAO\\Tests\\Unit\\": "tests/Unit",
      "Modules\\SAO\\Tests\\Feature\\": "tests/Feature",
      "Modules\\SAO\\Tests\\Integration\\": "tests/Integration",
      "Modules\\SAO\\Tests\\Support\\": "tests/Support/"
    },
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
